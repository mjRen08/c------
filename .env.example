# ============================================================
#  把本文件复制为 .env，然后填入你自己的 DeepSeek API Key
#  （Windows 下直接改文件名去不掉开头的点，可以用命令：
#     copy .env.example .env
#   或者用 VS Code 打开后"另存为" .env）
# ------------------------------------------------------------
#  Key 申请地址：https://platform.deepseek.com
#  不填也能正常运行网站，只是 AI 助手会提示未配置。
# ============================================================

DEEPSEEK_API_KEY=sk-在这里粘贴你自己的Key

# 服务端口，默认 3000
PORT=3000

# 模型：
#   deepseek-chat  = 直接输出答案（推荐，回答快）
#   deepseek-flash = 推理型模型，会先输出思考过程再给答案，
#                    用它时请把下面的 token 上限调大
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=2048
